<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="todo_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <div class="row">
                            <div class="col-12">
                                <h2>Todo Report</h2>
                                <table class="table table-sm">
                                    <tr>
                                        <th>Title</th>
                                        <td><t t-esc="o.name"/></td>
                                    </tr>
                                    <tr>
                                        <th>Assigned To</th>
                                        <td><t t-esc="o.user_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <th>Status</th>
                                        <td><t t-esc="o.status"/></td>
                                    </tr>
                                    <tr>
                                        <th>Priority</th>
                                        <td><t t-esc="o.priority"/></td>
                                    </tr>
                                    <tr>
                                        <th>Due Date</th>
                                        <td><t t-esc="o.due_date"/></td>
                                    </tr>
                                    <tr>
                                        <th>Progress</th>
                                        <td><t t-esc="o.progress"/>%</td>
                                    </tr>
                                </table>
                                <div t-if="o.description">
                                    <h3>Description</h3>
                                    <p><t t-esc="o.description"/></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="todo_analysis_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <div class="row">
                            <div class="col-12">
                                <h2>Todo Analysis</h2>
                                <div class="row">
                                    <div class="col-6">
                                        <h3>Status Distribution</h3>
                                        <table class="table table-sm">
                                            <tr>
                                                <th>Status</th>
                                                <th>Count</th>
                                                <th>Percentage</th>
                                            </tr>
                                            <t t-foreach="o.get_status_distribution()" t-as="status">
                                                <tr>
                                                    <td><t t-esc="status[0]"/></td>
                                                    <td><t t-esc="status[1]"/></td>
                                                    <td><t t-esc="status[2]"/>%</td>
                                                </tr>
                                            </t>
                                        </table>
                                    </div>
                                    <div class="col-6">
                                        <h3>Priority Distribution</h3>
                                        <table class="table table-sm">
                                            <tr>
                                                <th>Priority</th>
                                                <th>Count</th>
                                                <th>Percentage</th>
                                            </tr>
                                            <t t-foreach="o.get_priority_distribution()" t-as="priority">
                                                <tr>
                                                    <td><t t-esc="priority[0]"/></td>
                                                    <td><t t-esc="priority[1]"/></td>
                                                    <td><t t-esc="priority[2]"/>%</td>
                                                </tr>
                                            </t>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo> 