<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Todo Form View -->
    <record id="view_todo_form" model="ir.ui.view">
        <field name="name">todo.form</field>
        <field name="model">todo.todo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start" type="object" class="oe_highlight" states="draft"/>
                    <button name="action_done" string="Done" type="object" class="oe_highlight" states="in_progress"/>
                    <button name="action_cancel" string="Cancel" type="object" states="draft,in_progress"/>
                    <button name="action_reset" string="Reset" type="object" states="done,cancelled"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,in_progress,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Todo Title"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="priority"/>
                            <field name="due_date"/>
                        </group>
                        <group>
                            <field name="progress" widget="progressbar" options="{'current_value': progress}"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Todo Tree View -->
    <record id="view_todo_tree" model="ir.ui.view">
        <field name="name">todo.tree</field>
        <field name="model">todo.todo</field>
        <field name="arch" type="xml">
            <tree decoration-info="status=='draft'" decoration-warning="status=='in_progress'" decoration-success="status=='done'" decoration-muted="status=='cancelled'">
                <field name="name"/>
                <field name="user_id"/>
                <field name="status"/>
                <field name="priority"/>
                <field name="due_date"/>
                <field name="progress"/>
            </tree>
        </field>
    </record>

    <!-- Todo Kanban View -->
    <record id="view_todo_kanban" model="ir.ui.view">
        <field name="name">todo.kanban</field>
        <field name="model">todo.todo</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="user_id"/>
                <field name="status"/>
                <field name="priority"/>
                <field name="due_date"/>
                <field name="progress"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <span><t t-esc="record.name.value"/></span>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left text-muted">
                                    <span><t t-esc="record.user_id.value[1]"/></span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span class="badge" t-attf-class="badge-#{record.status.value == 'done' ? 'success' : record.status.value == 'in_progress' ? 'warning' : 'info'}">
                                        <t t-esc="record.status.value"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Todo Search View -->
    <record id="view_todo_search" model="ir.ui.view">
        <field name="name">todo.search</field>
        <field name="model">todo.todo</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="tag_ids"/>
                <filter string="Draft" name="draft" domain="[('status','=','draft')]"/>
                <filter string="In Progress" name="in_progress" domain="[('status','=','in_progress')]"/>
                <filter string="Done" name="done" domain="[('status','=','done')]"/>
                <filter string="Overdue" name="overdue" domain="[('due_date','&lt;',current_date),('status','!=','done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_status" context="{'group_by':'status'}"/>
                    <filter string="User" name="group_by_user" context="{'group_by':'user_id'}"/>
                    <filter string="Priority" name="group_by_priority" context="{'group_by':'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Todo Tag Form View -->
    <record id="view_todo_tag_form" model="ir.ui.view">
        <field name="name">todo.tag.form</field>
        <field name="model">todo.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tag Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Todo Tag Tree View -->
    <record id="view_todo_tag_tree" model="ir.ui.view">
        <field name="name">todo.tag.tree</field>
        <field name="model">todo.tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="color"/>
            </tree>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_todo" model="ir.actions.act_window">
        <field name="name">Todos</field>
        <field name="res_model">todo.todo</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="search_view_id" ref="view_todo_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first todo!
            </p>
        </field>
    </record>

    <record id="action_todo_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">todo.tag</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo> 